/.claude/worktrees/
/.claude/settings.local.json

# Local agent scratch that stays untracked on purpose (memory rule), and the
# browser-verification screenshots a live check leaves at the repo root.
/.agents/
/conpty_ref.rs
/term-*.png
/job-*.png
