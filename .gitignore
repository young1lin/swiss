/target
# The 19998 iteration build dir (AGENTS.md live-testing rule) — a whole second cargo
# target tree, thousands of files the Git GUI would otherwise list as pending.
/target-test/
**/*.rs.bk
*.pdb

# Local gateway state — same set the Node build never commits. All carry real secrets.
gateway.config.json
managed.json
tunnels.json
jobs.json
.env
*.log
master.key

# Stray dev binaries at the repo root (lmg-* are the pre-rename builds still on disk)
/swiss-dev.exe
/swiss.exe
/lmg.exe
/lmg-dev.exe

# Claude Code scratch: agent worktrees and per-machine settings
/.claude/worktrees/
/.claude/settings.local.json

# Dev-only npm tooling for the panel home (crates/swiss-panel/panel — sources, emit script
# and the vitest suite; docs/36) — node is a dev dependency, never a cargo build step; its
# install tree stays untracked.
/crates/swiss-panel/panel/node_modules/

# Agent-authored context under .agents is SOURCE now (docs/, skills/, skill-eval/,
# .mcp.json) and ships with the repo. The worktrees/ subtree stays untracked on purpose:
# each is a full checkout of THIS repo (git would nest the repo inside itself) plus its
# own target*/ build trees - ~157 GB of mechanical copies. Their source state travels in
# the diagnosis zip instead, not in git.
/.agents/worktrees/
/conpty_ref.rs
/term-*.png
/job-*.png
