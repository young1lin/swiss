/* The served sources (docs/36 D4). Browser code: no node types (types: [] keeps @types/node
   out of every src file - the panel must not learn about process or Buffer), strict from day
   one, and erasableSyntaxOnly so the emit tool's constraint and the checker's agree. The
   .js specifiers are deliberate: they resolve to the .ts sibling here and survive emission
   byte-for-byte, so the browser's import graph never moves (D5). */
{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
