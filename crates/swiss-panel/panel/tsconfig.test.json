/* The acceptance suite and the config: same rules as src, plus node's types - the tests read
   files, spawn the build script and fake timers, none of which a browser module may see. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
