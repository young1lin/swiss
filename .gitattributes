# One line-ending policy for the whole repo: LF in the index AND in the working tree,
# on every platform (see AGENTS.md "Line endings"). CRLF never enters a commit.
* text=auto eol=lf

# The emitted panel tree (SPEC §panel.toolchain): committed product, regenerated from
# crates/swiss-panel/panel/src by npm run build — marked generated so diffs and language
# stats skip it. LF normalization above still applies; emission writes LF only.
crates/swiss-panel/src/admin_assets/js/**/*.js linguist-generated=true

# Binary guards: git must never normalize or diff these (none tracked today).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.pdb binary
*.woff binary
*.woff2 binary
*.cast binary
