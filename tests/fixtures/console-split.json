    {
      "line": "SET k \"\\$5\"",
      "words": [
        "SET",
        "k",
        "$5"
      ],
      "panel": [
        "SET",
        "k",
        "\\$5"
      ],
      "why": "in double quotes the server's shlex also unescapes \\$ and \\`; the JS port keeps them - the value's text, never a boundary"
    },
    {
      "line": "SET k $'a\\tb'",
      "words": [
        "SET",
        "k",
        "$a\\tb"
      ],
      "panel": [
        "SET",
        "k",
        "a\tb"
      ],
      "why": "the JS port reads bash's $'...' quotes; the server reads a literal $ - the value's text, never a boundary"
    },
    {
      "line": "GET k\rx",
      "words": [
        "GET",
        "k\rx"
      ],
      "panel": [
        "GET",
        "k",
        "x"
      ],
      "why": "the JS port splits at a carriage return; a textarea's value never holds one (browsers normalise line breaks), an API caller's line can"
    }
